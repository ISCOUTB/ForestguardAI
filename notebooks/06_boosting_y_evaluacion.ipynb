    "from pathlib import Path\n",
    "import os\n",
    "import sys\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from IPython.display import display\n",
    "\n",
    "raiz = next(p for p in (Path.cwd(), *Path.cwd().parents) if (p / 'config/hito2.yaml').exists())\n",
    "os.chdir(raiz)\n",
    "sys.path.insert(0, str(raiz / 'scripts'))\n",
    "import linea_base_multizona as base\n",
    "\n",
    "cfg, huella = base.cargar_config('config/hito2.yaml')\n",
    "zonas = cfg['zonas']\n",
    "celdas = cfg['celdas']\n",
    "salida = Path('outputs/ruta_espacial')\n",
    "cache = Path('data/processed/ruta_espacial')\n",
    "salida.mkdir(parents=True, exist_ok=True)\n",
    "cache.mkdir(parents=True, exist_ok=True)"
   ]
  },
