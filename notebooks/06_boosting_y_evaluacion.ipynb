    "from sklearn.ensemble import HistGradientBoostingClassifier\n",
    "from threadpoolctl import threadpool_limits\n",
    "from src.forestguard.data import descargar_tesela\n",
    "from src.forestguard.features import FEATURES\n",
    "\n",
    "columnas = FEATURES + ['distancia_foco_celdas','tendencia_ha_anio','anillo_2_ha','anillo_3_ha']\n",
    "panel = pd.concat([pd.read_csv(cache / f'{z}.csv') for z in zonas['entrenamiento']], ignore_index=True)\n",
    "division = cfg['division_temporal']\n",
    "train = panel[panel.anio_pred.between(*division['entrenamiento'])]\n",
    "val = panel[panel.anio_pred.between(*division['validacion'])]\n",
    "assert train.anio_pred.max() < val.anio_pred.min()\n",
    "assert set(panel.zona).isdisjoint(zonas['retenidas'])\n",
    "assert train.alerta.nunique() == val.alerta.nunique() == 2\n",
    "ajustes = []\n",
    "with threadpool_limits(limits=2):\n",
    "    for semilla in cfg['linea_base']['semillas']:\n",
    "        modelo = HistGradientBoostingClassifier(max_iter=100, learning_rate=0.1, max_leaf_nodes=31,\n",
    "            l2_regularization=1, max_features=0.85, early_stopping=False, random_state=semilla)\n",
    "        modelo.fit(train[columnas], train.alerta)\n",
    "        riesgo = modelo.predict_proba(val[columnas])[:, 1]\n",
    "        umbral, recall, fpr = base.umbral_por_fpr(val.alerta, riesgo, cfg['umbral_riesgo']['fpr_max_validacion'])\n",
    "        ajustes.append((semilla, modelo, umbral, recall, fpr))\n",
    "        print(f'Semilla {semilla}: umbral {umbral:.4f}, recall validación {recall:.3f}, FPR {fpr:.3f}')"
   ]
  },
