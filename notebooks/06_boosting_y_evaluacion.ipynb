   "source": [
    "ruta = descargar_tesela(cfg['datos']['tesela'], capas=('lossyear',), destino=base.RAW,\n",
    "                        version=cfg['datos']['version_etiquetas_2025'])['lossyear']\n",
    "filas, casos = [], []\n",
    "k = cfg['metricas']['precision_top_k']['k']\n",
    "for zona in zonas['retenidas']:\n",
    "    d = pd.read_csv(cache / f'{zona}.csv').sort_values('celda_id')\n",
    "    real, coincidencia = base.etiquetas_2025(zona, ruta, celdas)\n",
    "    assert np.isclose(coincidencia, 1.0)\n",
    "    d = d.merge(real, on='celda_id', how='left', validate='one_to_one')\n",
    "    assert d.alerta.notna().all() and d.alerta.nunique() == 2 and len(d) >= k\n",
    "    for semilla, modelo, umbral, rec_val, fpr_val in ajustes:\n",
    "        with threadpool_limits(limits=2):\n",
    "            riesgo = modelo.predict_proba(d[columnas])[:, 1]\n",
    "        pred = riesgo >= umbral\n",
    "        filas.append(dict(modelo='boosting_espacial', zona=zona, semilla=semilla, umbral=umbral,\n",
    "                          recall_val=rec_val, fpr_val=fpr_val, **base.evaluar(d.alerta, riesgo, pred, k)))\n",
    "        if semilla == ajustes[0][0]:\n",
    "            errores = d.loc[pred != d.alerta].copy()\n",
    "            errores['tipo'] = np.where(errores.alerta == 1, 'FN', 'FP')\n",
    "            errores['riesgo'] = riesgo[pred != d.alerta]\n",
    "            for tipo, grupo in errores.groupby('tipo'):\n",
    "                casos.append(grupo.sort_values('riesgo', ascending=tipo=='FN').head(3))\n",
    "candidato = pd.DataFrame(filas)\n",
    "candidato.to_csv(salida / 'corridas.csv', index=False)\n",
    "ejemplos = pd.concat(casos)[['zona','celda_id','lat','lon','tipo','riesgo','perdida_ha_ultimo','distancia_foco_celdas','perdida_ha_2025']]\n",
    "ejemplos.to_csv(salida / 'errores.csv', index=False)\n",
    "display(ejemplos.round(3))"
   ]
  },
